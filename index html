                <span>SilverSpark.ir@gmail.com</span>
            </div>
            <div class="contact-item">
                <i class="fas fa-phone"></i>
                <span>۰۹۱۱۶۵۴۶۲۳۴</span>
            </div>
        </div>
        <div class="copyright">
            © ۲۰۲۴ کلیه حقوق برای <strong>SilverSpark</strong> محفوظ است
        </div>
    </footer>

    <script>
        let cart = [];
        const WHATSAPP_NUMBER = "989116546234";
        let currentPrices = {
            basket1: 150000, basket2: 600000, basket3: 1500000,
            gift1: 750000, gift2: 1800000, gift3: 3500000
        };
        let customerInfo = { name: '', phone: '' };
        let marqueeText = "🎯 بهترین قیمت نقره در بازار - تضمین کیفیت و اصالت - تحویل فوری در تهران 🎯";

        // تابع برای چک کردن پسوورد در بک‌اند
        async function checkAdminPassword(password) {
            try {
                const response = await fetch('https://your-backend-url.com/check-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ password: password })
                });
                const result = await response.json();
                return result.success;
            } catch (error) {
                console.error('Error checking password:', error);
                return false;
            }
        }

        function showSection(sectionName) {
            document.querySelectorAll('.content-section').forEach(section => section.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(sectionName).classList.add('active');
            event.target.classList.add('active');
        }
        
        function updateQuantity(productId, change) {
            const quantityElement = document.getElementById('quantity-' + productId);
            let quantity = parseInt(quantityElement.textContent);
            quantity += change;
            if (quantity < 1) quantity = 1;
            quantityElement.textContent = quantity;
        }
        
        function addToCart(productId, productName, basePrice) {
            const quantity = parseInt(document.getElementById('quantity-' + productId).textContent);
            const currentPrice = currentPrices[productId] || basePrice;
            const totalPrice = currentPrice * quantity;
            
            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += quantity;
                existingItem.price = currentPrice;
                existingItem.total = existingItem.quantity * currentPrice;
            } else {
                cart.push({
                    id: productId,
                    name: productName,
                    price: currentPrice,
                    quantity: quantity,
                    total: totalPrice
                });
            }
            
            updateCartDisplay();
            document.getElementById('quantity-' + productId).textContent = '1';
        }

        function updateCartDisplay() {
            const cartItems = document.getElementById('cartItems');
            const cartTotal = document.getElementById('cartTotal');
            const cartCount = document.getElementById('cartCount');
            
            cartItems.innerHTML = '';
            let total = 0;
            let itemCount = 0;
            
            cart.forEach(item => {
                item.total = item.price * item.quantity;
                total += item.total;
                itemCount += item.quantity;
                
                cartItems.innerHTML += `
                    <div class="cart-item">
                        <span>${item.name}</span>
                        <div>
                            <button class="quantity-btn" onclick="updateCartItemQuantity('${item.id}', -1)">-</button>
                            <span class="quantity-display">${item.quantity}</span>
                            <button class="quantity-btn" onclick="updateCartItemQuantity('${item.id}', 1)">+</button>
                            <span>${item.total.toLocaleString()} تومان</span>
                            <button class="quantity-btn" onclick="removeFromCart('${item.id}')" style="background: #e74c3c; color: white;">❌</button>
                        </div>
                    </div>
                `;
            });
            
            cartTotal.textContent = total.toLocaleString();
            cartCount.textContent = itemCount;
        }

        function updateCartItemQuantity(productId, change) {
            const item = cart.find(item => item.id === productId);
            if (item) {
                item.quantity += change;
                if (item.quantity < 1) {
                    removeFromCart(productId);
                } else {
                    item.total = item.price * item.quantity;
                    updateCartDisplay();
                }
            }
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartDisplay();
        }

        function toggleCart() {
            const cartSection = document.getElementById('cartSection');
            cartSection.style.display = cartSection.style.display === 'flex' ? 'none' : 'flex';
        }

        function closeCart() {
            document.getElementById('cartSection').style.display = 'none';
        }

        function showPaymentPage() {
            if (cart.length === 0) {
                alert('سبد خرید شما خالی است!');
                return;
            }
            
            const paymentPage = document.getElementById('paymentPage');
            const invoiceNumber = document.getElementById('invoiceNumber');
            
            const now = new Date();
            const invoiceNum = `INV-${now.getFullYear()}${(now.getMonth()+1).toString().padStart(2, '0')}${now.getDate().toString().padStart(2, '0')}-${Math.floor(Math.random() * 1000).toString().padStart(3, '0')}`;
            invoiceNumber.textContent = `شماره فاکتور: ${invoiceNum}`;
            
            paymentPage.style.display = 'flex';
        }

        function validateCustomerInfo() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();
            
            if (!name) {
                alert('لطفاً نام و نام خانوادگی خود را وارد کنید.');
                return;
            }
            
            if (!phone || phone.length < 10) {
                alert('لطفاً شماره تماس معتبر وارد کنید.');
                return;
            }
            
            customerInfo = { name, phone };
            document.getElementById('invoiceDetails').style.display = 'block';
            document.getElementById('whatsappBtn').style.display = 'block';
            showInvoiceDetails();
        }

        function showInvoiceDetails() {
            const invoiceDetails = document.getElementById('invoiceDetails');
            let total = 0;
            
            let invoiceHTML = '<h4>📋 اقلام سفارش:</h4>';
            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                invoiceHTML += `
                    <div class="invoice-item">
                        <span>${item.name} (${item.quantity} عدد)</span>
                        <span>${itemTotal.toLocaleString()} تومان</span>
                    </div>
                `;
            });
            
            invoiceHTML += `
                <div class="invoice-item" style="font-weight: bold; border-top: 2px solid #c0a050; margin-top: 10px; padding-top: 10px;">
                    <span>جمع کل:</span>
                    <span>${total.toLocaleString()} تومان</span>
                </div>
            `;
            
            invoiceDetails.innerHTML = invoiceHTML;
        }

        function closePayment() {
            document.getElementById('paymentPage').style.display = 'none';
            document.getElementById('invoiceDetails').style.display = 'none';
            document.getElementById('whatsappBtn').style.display = 'none';
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
        }

        function sendToWhatsApp() {
            if (!customerInfo.name || !customerInfo.phone) {
                alert('لطفاً ابتدا اطلاعات مشتری را تکمیل کنید.');
                return;
            }

            const invoiceNumber = document.getElementById('invoiceNumber').textContent;
            const now = new Date().toLocaleDateString('fa-IR');
            let totalAmount = 0;

            let message = `📋 *فاکتور خرید نقره*\n\n`;
            message += `👤 *مشتری:* ${customerInfo.name}\n`;
            message += `📞 *شماره تماس:* ${customerInfo.phone}\n`;
            message += `📄 *شماره فاکتور:* ${invoiceNumber}\n`;
            message += `📅 *تاریخ:* ${now}\n\n`;
            message += `🛒 *لیست اقلام:*\n`;

            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                totalAmount += itemTotal;
                message += `${index + 1}. ${item.name} (${item.quantity} عدد) - ${itemTotal.toLocaleString()} تومان\n`;
            });

            message += `\n💰 *جمع کل:* ${totalAmount.toLocaleString()} تومان\n\n`;
            message += `⚠️ *توجه:* فاکتور تا یک ساعت اعتبار دارد\n\n`;
            message += `⚡ *نقره‌تاب | SilverSpark*`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappURL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`;
            
            window.open(whatsappURL, '_blank');
            
            alert('فاکتور با موفقیت به واتساپ ارسال شد. لطفاً پیام را تأیید و ارسال کنید.');
        }

        async function showAdmin() {
            const password = prompt('رمز مدیریت را وارد کنید:');
            if (password) {
                const isValid = await checkAdminPassword(password);
                if (isValid) {
                    document.getElementById('adminPanel').style.display = 'block';
                    loadCurrentSettings();
                } else {
                    alert('رمز اشتباه است!');
                }
            }
        }

        function hideAdmin() {
            document.getElementById('adminPanel').style.display = 'none';
        }

        function saveSilverPrice() {
            const pricePerGram = document.getElementById('adminPriceInput').value;
            
            if (!pricePerGram || pricePerGram < 1000) {
                alert('لطفاً قیمت معتبر وارد کنید!');
                return;
            }

            const PRICE_FACTORS = {
                investment: 1.0,
                gift: {
                    gift1: 1.10,  // 10% افزایش برای پک ۲۰ گرمی
                    gift2: 1.07,  // 7% افزایش برای پک ۵۰ گرمی
                    gift3: 1.05   // 5% افزایش برای پک ۱۰۰ گرمی
                }
            };

            const calculatedPrices = {
                // سرمایه‌گذاری (بدون افزایش)
                basket1: Math.round(pricePerGram * 5 * PRICE_FACTORS.investment),
                basket2: Math.round(pricePerGram * 20 * PRICE_FACTORS.investment),
                basket3: Math.round(pricePerGram * 50 * PRICE_FACTORS.investment),
                
                // پک کادویی (با افزایش درصدی)
                gift1: Math.round(pricePerGram * 20 * PRICE_FACTORS.gift.gift1),
                gift2: Math.round(pricePerGram * 50 * PRICE_FACTORS.gift.gift2),
                gift3: Math.round(pricePerGram * 100 * PRICE_FACTORS.gift.gift3)
            };

            currentPrices = calculatedPrices;
            
            document.querySelectorAll('[data-price]').forEach(element => {
                const priceKey = element.getAttribute('data-price');
                if (calculatedPrices[priceKey]) {
                    element.textContent = calculatedPrices[priceKey].toLocaleString() + ' تومان';
                }
            });

            cart.forEach(item => {
                if (calculatedPrices[item.id]) {
                    item.price = calculatedPrices[item.id];
                    item.total = item.price * item.quantity;
                }
            });
            updateCartDisplay();

            const now = new Date().toLocaleString('fa-IR');
            document.getElementById('lastUpdate').textContent = `آخرین بروزرسانی: ${now}`;
            
            alert(`✅ قیمت هر گرم بروزرسانی شد!\n\n💰 قیمت جدید: ${parseInt(pricePerGram).toLocaleString()} تومان\n\n📦 افزایش قیمت پک‌های کادویی:\n• پک ۲۰ گرمی: ۱۰٪\n• پک ۵۰ گرمی: ۷٪\n• پک ۱۰۰ گرمی: ۵٪`);
        }

        function saveMarqueeText() {
            const newText = document.getElementById('marqueeInput').value.trim();
            if (!newText) {
                alert('لطفاً متن مورد نظر را وارد کنید.');
                return;
            }

            marqueeText = newText;
            document.getElementById('marqueeText').textContent = newText;
            
            const now = new Date().toLocaleString('fa-IR');
            document.getElementById('lastUpdate').textContent = `آخرین بروزرسانی: ${now}`;
            
            alert('✅ متن نوار متحرک با موفقیت بروزرسانی شد!');
        }

        function loadCurrentSettings() {
            // بارگذاری تنظیمات فعلی
            document.getElementById('marqueeInput').value = marqueeText;
        }

        function contactForCustomOrder(productName) {
            alert(`📞 برای دریافت مشاوره و قیمت ${productName} با شماره زیر تماس بگیرید:\n\n۰۹۱۱۶۵۴۶۲۳۴\n\nیا از طریق واتساپ پیام دهید.`);
        }

        // بارگذاری اولیه
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('marqueeText').textContent = marqueeText;
        });
    </script>
</body>
</html>