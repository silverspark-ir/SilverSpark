<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نقره‌تاب | SilverSpark</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); color: #2c3e50; line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }
        .header { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); padding: 3rem 1rem; text-align: center; border-bottom: 4px solid #c0a050; position: relative; }
        .marquee-bar { background: #00ff00; /* رنگ فسفری */ color: #000000; /* نوشته مشکی */ padding: 10px 0; overflow: hidden; position: relative; font-weight: bold; font-size: 1.1rem; border-bottom: 2px solid #c0a050; }
        .marquee-content { display: inline-block; white-space: nowrap; animation: marquee 25s linear infinite; padding-right: 100%; }
        @keyframes marquee { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
        .logo-container { margin-bottom: 1rem; }
        .main-logo { height: 100px; width: auto; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5)); }
        .brand-name { font-size: 3.5rem; font-weight: bold; background: linear-gradient(135deg, #c0a050, #d4af37); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 0.5rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3); }
        .brand-subtitle { font-size: 1.8rem; color: #bdc3c7; font-weight: 300; margin-bottom: 0.5rem; letter-spacing: 2px; }
        .brand-tagline { color: #95a5a6; font-size: 1.1rem; margin-top: 0.5rem; }
        .content-nav { display: flex; justify-content: center; gap: 1rem; margin: 2rem auto; max-width: 800px; padding: 0 1rem; flex-wrap: wrap; }
        .nav-btn { background: white; border: 2px solid #c0a050; padding: 12px 24px; border-radius: 25px; cursor: pointer; transition: all 0.3s ease; font-weight: 500; }
        .nav-btn.active { background: #c0a050; color: white; }
        .nav-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(192, 160, 80, 0.3); }
        .content-section { display: none; max-width: 1200px; margin: 0 auto; padding: 0 1rem; flex: 1; }
        .content-section.active { display: block; }
        .section-title { text-align: center; margin-bottom: 2rem; color: #2c3e50; font-size: 2rem; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 3rem; }
        .product-card { background: white; border-radius: 15px; padding: 1.5rem; box-shadow: 0 5px 20px rgba(0,0,0,0.1); text-align: center; transition: transform 0.3s ease; border-right: 4px solid #c0a050; }
        .product-card:hover { transform: translateY(-5px); }
        .product-image { width: 100%; height: 200px; object-fit: cover; border-radius: 10px; margin-bottom: 1rem; }
        .product-name { font-size: 1.3rem; color: #2c3e50; margin-bottom: 0.5rem; }
        .product-weight { color: #7f8c8d; margin-bottom: 1rem; }
        .product-price { font-size: 1.5rem; font-weight: bold; color: #e67e22; margin-bottom: 1.5rem; }
        .quantity-controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem; }
        .quantity-btn { width: 35px; height: 35px; border: 1px solid #c0a050; background: white; border-radius: 50%; cursor: pointer; font-size: 1.2rem; }
        .quantity-display { font-size: 1.2rem; font-weight: bold; min-width: 30px; text-align: center; }
        .add-to-cart { background: linear-gradient(135deg, #c0a050, #b8941f); color: white; border: none; padding: 12px 24px; border-radius: 25px; cursor: pointer; width: 100%; font-size: 1rem; transition: all 0.3s ease; margin-bottom: 0.5rem; }
        .add-to-cart:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(192, 160, 80, 0.4); }
        .contact-btn { background: linear-gradient(135deg, #3498db, #2980b9); color: white; border: none; padding: 12px 24px; border-radius: 25px; cursor: pointer; width: 100%; font-size: 1rem; transition: all 0.3s ease; }
        .contact-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4); }
        .story-section { text-align: center; padding: 3rem 1rem; }
        .story-image { width: 100%; max-width: 500px; height: 300px; object-fit: cover; border-radius: 15px; margin-bottom: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
        .read-story-btn { background: linear-gradient(135deg, #9b59b6, #8e44ad); color: white; border: none; padding: 15px 30px; border-radius: 25px; font-size: 1.1rem; cursor: pointer; transition: all 0.3s ease; text-decoration: none; display: inline-block; }
        .read-story-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(155, 89, 182, 0.4); }
        .admin-panel { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #2c3e50; color: white; padding: 2rem; border-radius: 15px; border: 3px solid #c0a050; z-index: 3000; display: none; text-align: center; max-width: 500px; width: 90%; }
        .admin-toggle { position: fixed; top: 60px; left: 10px; background: #e74c3c; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; z-index: 1000; }
        .admin-btn { background: #c0a050; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin: 5px; }
        .price-input { width: 200px; padding: 10px; margin: 10px; border: 2px solid #c0a050; border-radius: 10px; background: #34495e; color: white; font-size: 1.1rem; text-align: center; }
        .text-input { width: 100%; padding: 10px; margin: 10px 0; border: 2px solid #c0a050; border-radius: 10px; background: #34495e; color: white; font-size: 1rem; text-align: center; }
        .cart-section { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; justify-content: center; align-items: center; z-index: 2000; }
        .cart-content { background: white; padding: 2rem; border-radius: 15px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto; color: #2c3e50; }
        .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid #eee; }
        .cart-total { text-align: center; font-size: 1.2rem; margin: 1rem 0; padding: 1rem; background: #f8f9fa; border-radius: 10px; }
        .cart-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
        .cart-toggle { position: fixed; top: 10px; right: 10px; background: #27ae60; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; z-index: 1000; }
        .payment-section { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: none; justify-content: center; align-items: center; z-index: 4000; color: white; padding: 1rem; }
        .payment-content { background: #2c3e50; max-width: 600px; width: 95%; padding: 2rem; border-radius: 15px; border: 3px solid #c0a050; max-height: 90vh; overflow-y: auto; }
        .invoice-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #34495e; }
        .customer-form { background: #34495e; padding: 1.5rem; border-radius: 10px; margin: 1rem 0; }
        .form-group { margin-bottom: 1rem; }
        .form-input { width: 100%; padding: 12px; border: 2px solid #c0a050; border-radius: 8px; background: #2c3e50; color: white; font-size: 1rem; }
        .form-input::placeholder { color: #95a5a6; }
        .warning-box { background: #e74c3c; padding: 1rem; border-radius: 10px; margin: 1rem 0; text-align: center; font-weight: bold; border: 2px solid #c0392b; }
        .footer { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); color: white; padding: 2rem 1rem; text-align: center; margin-top: auto; border-top: 4px solid #c0a050; }
        .social-links { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; }
        .social-icon { width: 45px; height: 45px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; transition: all 0.3s ease; text-decoration: none; color: white; }
        .social-icon:hover { background: #c0a050; transform: translateY(-3px); }
        .contact-info { margin-bottom: 1.5rem; }
        .contact-item { margin: 0.5rem 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .copyright { color: rgba(255,255,255,0.7); font-size: 0.9rem; margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 1rem; }
        @media (max-width: 768px) {
            .brand-name { font-size: 2.5rem; }
            .brand-subtitle { font-size: 1.3rem; }
            .content-nav { flex-direction: column; align-items: center; }
            .nav-btn { width: 200px; }
            .products-grid { grid-template-columns: 1fr; }
            .social-links { gap: 1rem; }
            .social-icon { width: 40px; height: 40px; font-size: 1.1rem; }
            .admin-toggle { top: 50px; }
            .cart-actions { flex-direction: column; }
            .marquee-bar { font-size: 0.9rem; padding: 8px 0; }
        }
    </style>
</head>
<body>
    <button class="cart-toggle" onclick="toggleCart()">🛒 <span id="cartCount">۰</span></button>
    <button class="admin-toggle" onclick="showAdmin()">⚙️ مدیریت</button>

    <header class="header">
        <div class="logo-container">
            <img src="https://i.imgur.com/LVGuf4m.jpeg" alt="نقره‌تاب" class="main-logo">
        </div>
        <div class="brand-name">نقره‌تاب</div>
        <div class="brand-subtitle">SilverSpark</div>
        <div class="brand-tagline">نقره خام با عیار تضمینی</div>
    </header>
    
    <div class="marquee-bar">
        <div class="marquee-content" id="marqueeText">🎯 بهترین قیمت نقره در بازار - تضمین کیفیت و اصالت - تحویل فوری در تهران 🎯</div>
    </div>
    
    <nav class="content-nav">
        <button class="nav-btn active" onclick="showSection('investment')">💰 سرمایه‌گذاری</button>
        <button class="nav-btn" onclick="showSection('gift')">🎁 پک‌های کادویی</button>
        <button class="nav-btn" onclick="showSection('story')">📖 داستان نقره</button>
    </nav>
    
    <div class="admin-panel" id="adminPanel">
        <h3>🔧 پنل مدیریت نقره‌تاب</h3>
        
        <div style="margin: 1rem 0;">
            <label>قیمت هر گرم نقره (تومان):</label>
            <br>
            <input type="number" id="adminPriceInput" class="price-input" placeholder="مثلاً 30000">
        </div>
        
        <div style="margin: 1rem 0;">
            <label>متن نوار متحرک:</label>
            <br>
            <input type="text" id="marqueeInput" class="text-input" placeholder="متن مورد نظر برای نوار متحرک">
        </div>
        
        <button class="admin-btn" onclick="saveSilverPrice()">💾 ذخیره قیمت</button>
        <button class="admin-btn" onclick="saveMarqueeText()">📝 ذخیره متن متحرک</button>
        <button class="admin-btn" onclick="hideAdmin()" style="background: #e74c3c;">❌ بستن</button>
        
        <div class="last-update" id="lastUpdate" style="color: #95a5a6; font-size: 0.9rem; margin-top: 1rem;">آخرین بروزرسانی: هرگز</div>
    </div>
    
    <div class="cart-section" id="cartSection">
        <div class="cart-content">
            <h3>🛒 سبد خرید شما</h3>
            <div class="cart-items" id="cartItems"></div>
            <div class="cart-total"><strong>جمع کل: <span id="cartTotal">۰</span> تومان</strong></div>
            <div class="cart-actions">
                <button class="contact-btn" onclick="showPaymentPage()">💳 پرداخت</button>
                <button class="admin-btn" onclick="closeCart()" style="background: #e74c3c;">بستن</button>
            </div>
        </div>
    </div>
    
    <div class="payment-section" id="paymentPage">
        <div class="payment-content">
            <div style="text-align: center; margin-bottom: 2rem;">
                <h2>🧾 فاکتور خرید نقره</h2>
                <div id="invoiceNumber" style="color: #95a5a6; font-size: 0.9rem;"></div>
            </div>
            
            <div class="warning-box">
                ⚠️ به دلیل نوسانات قیمت، فاکتور تا یک ساعت اعتبار دارد
            </div>
            
            <div class="customer-form">
                <h4>📝 اطلاعات مشتری</h4>
                <div class="form-group">
                    <input type="text" id="customerName" class="form-input" placeholder="نام و نام خانوادگی">
                </div>
                <div class="form-group">
                    <input type="tel" id="customerPhone" class="form-input" placeholder="شماره تماس">
                </div>
                <button class="contact-btn" onclick="validateCustomerInfo()" style="width: 100%;">تأیید اطلاعات و ادامه</button>
            </div>
            
            <div id="invoiceDetails" style="margin-bottom: 1.5rem; display: none;"></div>
            
            <div class="cart-actions">
                <button class="add-to-cart" onclick="sendToWhatsApp()" id="whatsappBtn" style="display: none; background: #25D366;">📱 ارسال به واتساپ</button>
                <button class="contact-btn" onclick="closePayment()">بستن</button>
            </div>
        </div>
    </div>
    
